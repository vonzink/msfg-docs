<div class="doc-page application-summary">
  <div class="doc-page__header">
    <h1><%= doc.icon %> <%= doc.name %></h1>
    <p><%= doc.description %></p>
  </div>

  <div class="doc-page__body">
    <div class="calc-section app-summary-source" data-print="hide">
      <h2><span class="section-number">1</span> MISMO source</h2>
      <div class="app-summary-source__grid">
        <div class="app-summary-source__panel">
          <input type="file" id="applicationSummaryFile" accept=".xml,text/xml,application/xml,.mismo" class="u-sr-only">
          <div>
            <strong id="applicationSummarySourceTitle">No MISMO loaded</strong>
            <span id="applicationSummarySourceMeta">Open this document in Workspace after importing MISMO, or upload XML here.</span>
          </div>
          <div class="app-summary-source__actions">
            <label class="btn btn-sm btn-primary" for="applicationSummaryFile">Upload MISMO</label>
            <button class="btn btn-sm btn-ghost" type="button" id="applicationSummaryClear">Clear</button>
          </div>
        </div>
        <div class="app-summary-status-grid" id="applicationSummaryStatusGrid">
          <div class="app-summary-status-card" data-status-area="residence">
            <span>Residence history</span>
            <strong>Needs MISMO</strong>
          </div>
          <div class="app-summary-status-card" data-status-area="employment">
            <span>Employment history</span>
            <strong>Needs MISMO</strong>
          </div>
          <div class="app-summary-status-card" data-status-area="actions">
            <span>Review items</span>
            <strong>--</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="calc-section">
      <h2><span class="section-number">2</span> Borrower review packet</h2>
      <!-- A/B/C document style for the Application Summary PDF. Reuses the
           letter picker's styling + active-state wiring; application-summary.js
           reads the choice into the download payload and recolours the preview. -->
      <div class="letter-style-picker" role="radiogroup" aria-label="Document style"
           data-doc-slug="<%= (typeof doc !== 'undefined' && doc) ? doc.slug : '' %>">
        <span class="letter-style-picker__label">Style</span>
        <div class="letter-style-picker__opts">
          <button type="button" class="letter-style-picker__opt" role="radio" aria-checked="true" data-style="A">
            <span class="letter-style-picker__name">Evergreen</span>
            <span class="letter-style-picker__sub">Green</span>
          </button>
          <button type="button" class="letter-style-picker__opt" role="radio" aria-checked="false" data-style="B">
            <span class="letter-style-picker__name">Ledger</span>
            <span class="letter-style-picker__sub">Teal</span>
          </button>
          <button type="button" class="letter-style-picker__opt" role="radio" aria-checked="false" data-style="C">
            <span class="letter-style-picker__name">Plain</span>
            <span class="letter-style-picker__sub">Ink</span>
          </button>
        </div>
      </div>
      <div id="applicationSummaryPreview" class="app-summary-preview">
        <div class="app-summary-empty">
          <h3>Application Summary</h3>
          <p>Import MISMO XML to build the borrower review packet.</p>
        </div>
      </div>
    </div>

    <div class="action-bar doc-actions">
      <button type="button" class="btn btn-primary icon-inline" data-action="doc-export-pdf">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 12v6"/><path d="M9 15h6"/></svg>
        Export PDF
      </button>
      <button type="button" class="btn btn-secondary icon-inline" data-action="doc-print">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Print
      </button>
      <button type="button" class="btn btn-secondary icon-inline" data-action="doc-email">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Email
      </button>
    </div>
  </div>
</div>
