<!-- Letter appearance settings — compact gear button + popover.
     Render this INLINE inside the Letter Preview section header so
     the gear visually belongs to the preview it controls. The panel
     opens below the gear as a floating popover (click-outside to
     dismiss; Esc closes). Settings persist per-doc-slug (with an
     optional "Apply to all letters" toggle that also writes the
     global default) and apply live to the .letter-preview via CSS
     custom properties + state classes. The same settings object is
     read by each doc's Download client and sent in the PDF payload
     so lib/pdf/letterPdf.js produces matching output. -->
<span class="letter-settings" data-doc-slug="<%= (typeof doc !== 'undefined' && doc) ? doc.slug : '' %>">
  <button type="button" class="letter-settings__gear" id="letterSettingsToggle"
          aria-expanded="false" aria-controls="letterSettingsPanel"
          aria-haspopup="dialog" title="Letter appearance">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"/>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
    </svg>
    <span class="sr-only">Letter appearance</span>
  </button>

  <div class="letter-settings__panel" id="letterSettingsPanel" role="dialog" aria-label="Letter appearance settings" hidden>
    <div class="letter-settings__panel-head">
      <span class="letter-settings__panel-title">Letter appearance</span>
      <button type="button" class="letter-settings__reset" id="letterSettingsReset" title="Reset all settings to defaults">Reset</button>
    </div>

    <!-- Core controls come first — users land on the detail they came
         here to adjust. Presets are pinned at the bottom as a quick
         starting point. -->
    <div class="letter-settings__grid">
      <div class="letter-settings__field">
        <label for="lsFontFamily">Font</label>
        <select id="lsFontFamily" data-setting="fontFamily">
          <option value="times">Serif — Times</option>
          <option value="helvetica">Sans-serif — Helvetica</option>
        </select>
      </div>
      <div class="letter-settings__field">
        <label for="lsFontSize">Font size</label>
        <select id="lsFontSize" data-setting="fontSize">
          <option value="9">9 pt — tight</option>
          <option value="10">10 pt</option>
          <option value="11">11 pt — default</option>
          <option value="12">12 pt</option>
          <option value="13">13 pt — large</option>
        </select>
      </div>
      <div class="letter-settings__field letter-settings__field--full">
        <label for="lsAccentText">Accent color</label>
        <div class="letter-settings__color">
          <input type="color" id="lsAccent" data-setting="accent" aria-label="Accent color picker">
          <input type="text" id="lsAccentText" data-setting="accent" maxlength="7" placeholder="#2d6a4f" spellcheck="false" aria-label="Accent color hex">
        </div>
        <p class="letter-settings__hint letter-settings__hint--error" id="lsAccentError" hidden>Enter a 6-digit hex like <code>#2d6a4f</code>.</p>
      </div>
      <div class="letter-settings__field">
        <label for="lsTableStyle">Table style</label>
        <select id="lsTableStyle" data-setting="tableStyle">
          <option value="plain">Plain</option>
          <option value="dotted">Dotted underlines</option>
          <option value="striped">Striped rows</option>
          <option value="accentKey">Accent key column</option>
          <option value="thin">Thin rule rows</option>
        </select>
      </div>
      <div class="letter-settings__field">
        <label for="lsTitleAlign">Title alignment</label>
        <select id="lsTitleAlign" data-setting="titleAlign">
          <option value="left">Left</option>
          <option value="center">Center</option>
        </select>
      </div>
      <div class="letter-settings__field">
        <label for="lsMargin">Margins</label>
        <select id="lsMargin" data-setting="margin">
          <option value="narrow">Narrow</option>
          <option value="normal">Normal</option>
          <option value="wide">Wide</option>
        </select>
      </div>
    </div>

    <div class="letter-settings__toggles">
      <label class="letter-settings__toggle"><input type="checkbox" data-setting="headerBand"> Header band</label>
      <label class="letter-settings__toggle"><input type="checkbox" data-setting="footerBand"> Footer band</label>
      <label class="letter-settings__toggle"><input type="checkbox" data-setting="leftRail"> Left accent rail</label>
      <label class="letter-settings__toggle"><input type="checkbox" data-setting="justify"> Justify body text</label>
    </div>

    <!-- Per-doc vs shared scope. When unchecked (default), settings
         apply only to THIS doc type. When checked, the current values
         also become the fallback default for all other letter docs. -->
    <label class="letter-settings__scope">
      <input type="checkbox" id="lsApplyAll">
      <span>Apply to all letter types</span>
    </label>

    <!-- Quick starts — preset combos. Pinned below core controls so
         the panel leads with granular options (the whole point of
         replacing the 4-preset picker). -->
    <div class="letter-settings__quickstarts">
      <span class="letter-settings__quickstarts-label">Quick starts</span>
      <div class="letter-settings__preset-chips">
        <button type="button" class="letter-settings__preset" data-preset="classic">Classic</button>
        <button type="button" class="letter-settings__preset" data-preset="modern">Modern</button>
        <button type="button" class="letter-settings__preset" data-preset="branded">Branded</button>
        <button type="button" class="letter-settings__preset" data-preset="compact">Compact</button>
      </div>
    </div>
  </div>
</span>
